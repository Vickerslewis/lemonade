---
import Base from '../layouts/Base.astro';
import { medications as m, formatDate } from '../lib/data';
import { url } from '../lib/url';

const tbd = (v: string) => v === '{{TBD}}';
const reminders = [...m.reminders].sort((a: any, b: any) => (a.due ?? '9999').localeCompare(b.due ?? '9999'));
---

<Base title="Medications" description="Emergency medication, supplements, past medication and future options.">
  <header class="page-head">
    <h1>Medications</h1>
    <p class="lede">{m.summary}</p>
  </header>

  <h2 style="margin-top:0">Emergency and as-needed</h2>
  <div class="grid grid-2">
    {
      m.emergency.map((e: any) => (
        <div class="card emergency">
          <p class="meta">{e.route}</p>
          <h3 style="margin-top:2px">{e.drug}</h3>
          <p class="dose">{tbd(e.dose) ? <span class="tbd">Dose not recorded</span> : e.dose}</p>
          <p style="margin-top:6px">{e.when}</p>
          <p class="meta" style="margin-top:8px">Available since {e.since}</p>
        </div>
      ))
    }
  </div>
  <p style="margin-top:12px"><a href={url('/action-plan/')}>See the full seizure action plan →</a></p>

  <h2>Current</h2>
  <div class="table-wrap">
    <table class="stack">
      <thead><tr><th>Drug</th><th>Dose</th><th>Frequency</th><th>Purpose</th><th>Status</th></tr></thead>
      <tbody>
        {
          m.current.map((d: any) => (
            <tr>
              <td class="row-title"><strong>{d.drug}</strong><br /><span class="meta">{d.class}</span></td>
              <td class="num" data-label="Dose">{d.dose}</td>
              <td data-label="Frequency">{d.frequency}</td>
              <td data-label="Purpose">{d.purpose}</td>
              <td data-label="Status"><span class="badge badge-good">{d.status}</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Supplements and other products</h2>
  <div class="table-wrap">
    <table class="stack">
      <thead><tr><th>Product</th><th>Purpose</th><th>Notes</th></tr></thead>
      <tbody>
        {
          m.supplements.map((s: any) => (
            <tr>
              <td class="row-title"><strong>{s.product}</strong></td>
              <td data-label="Purpose">{s.purpose}</td>
              <td data-label="Notes">{s.notes}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="meta">Joint supplements are listed under <a href={url('/care/diet-and-supplements/')}>diet and supplements</a>.</p>

  <h2>Reminders</h2>
  <div class="table-wrap">
    <table class="stack">
      <thead><tr><th>Task</th><th>Due</th><th>Repeats</th></tr></thead>
      <tbody>
        {
          reminders.map((r: any) => (
            <tr>
              <td class="row-title">{r.task}</td>
              <td class="num" data-label="Due">{r.due ? formatDate(r.due, true) : '—'}</td>
              <td data-label="Repeats" class:list={{ 'hide-sm': !r.repeat }}>{r.repeat ?? '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Past medication</h2>
  <div class="table-wrap">
    <table class="stack">
      <thead><tr><th>Drug</th><th>Dose</th><th>Purpose</th><th>Dates</th><th>Why stopped</th></tr></thead>
      <tbody>
        {
          m.past.map((d: any) => (
            <tr>
              <td class="row-title"><strong>{d.drug}</strong></td>
              <td data-label="Dose">{tbd(d.dose) ? <span class="tbd">not recorded</span> : d.dose}</td>
              <td data-label="Purpose">{d.purpose}</td>
              <td class="num" data-label="Dates">{d.dates}</td>
              <td data-label="Why stopped">{d.reason}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Future options</h2>
  <dl class="options">
    {
      m.reserved.map((r: any) => (
        <div>
          <dt>{r.name}</dt>
          <dd>{r.notes}</dd>
        </div>
      ))
    }
  </dl>
</Base>

<style>
  .emergency {
    background: var(--critical-bg);
    border-color: color-mix(in srgb, var(--critical) 28%, transparent);
  }

  .dose {
    color: var(--ink);
    font-weight: 650;
  }

  .options {
    margin: 0;
    max-width: 72ch;
  }

  .options div {
    padding: 12px 0;
    border-top: 1px solid var(--grid);
  }

  .options dt {
    font-weight: 650;
  }

  .options dd {
    margin: 2px 0 0;
    color: var(--ink-2);
  }
</style>
