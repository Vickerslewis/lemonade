---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ChartFigure from '../components/ChartFigure.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { seizures, prodromes, seizureStats, formatDate, formatDuration, daysBetween } from '../lib/data';
import { laneEvents } from '../lib/events';
import { url } from '../lib/url';

const stats = seizureStats();
const buildDate = new Date().toISOString().slice(0, 10);
const events = await laneEvents();
const gaps = stats.gaps.map((g, i) => ({ ...g, label: `gap-${i}` }));
const patterns = await getEntry('pages', 'seizure-patterns');
const { Content: Patterns } = await render(patterns!);
const youtubeId = (video: string) => video.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/)?.[1];
const laneLabel ={ seizure: 'Seizure', prodrome: 'Warning signs', vet: 'Appointment' } as const;
---

<Base title="Seizures" description="Every seizure and warning-sign episode, with gaps and patterns.">
  <header class="page-head">
    <h1>Seizure log</h1>
    <p class="lede">Every seizure and every episode of warning signs. Gaps count a cluster (two seizures in one day) as one episode.</p>
  </header>

  <div style="margin-bottom:14px"><EmergencyBanner /></div>

  <div class="grid grid-4">
    <div class="tile">
      <p class="tile-label">Days since the last seizure</p>
      <p class="tile-value"><span data-days-since={stats.last}>{daysBetween(stats.last, buildDate)}</span></p>
      <p class="tile-note">{formatDate(stats.last)}</p>
    </div>
    <div class="tile">
      <p class="tile-label">Seizures recorded</p>
      <p class="tile-value">{stats.count}</p>
      <p class="tile-note">{stats.episodes} episodes, {stats.clusters} cluster</p>
    </div>
    <div class="tile">
      <p class="tile-label">Longest gap</p>
      <p class="tile-value">{stats.longestGap} <small>days</small></p>
    </div>
    <div class="tile">
      <p class="tile-label">Average gap</p>
      <p class="tile-value">{stats.averageGap} <small>days</small></p>
      <p class="tile-note">Small sample — not a prediction</p>
    </div>
  </div>

  <div class="grid" style="margin-top:14px">
    <ChartFigure
      title="Seizures, warning signs and appointments"
      subtitle="Since the first seizure. Hover or tap a mark for details."
      chart="lanes"
      points={events}
      legend={[
        { label: 'Seizure', shape: 'circle', color: 'var(--series-1)' },
        { label: 'Warning signs', shape: 'diamond', color: 'var(--series-2)' },
        { label: 'Appointment', shape: 'square', color: 'var(--series-3)' },
      ]}
    >
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Event</th><th>Detail</th></tr></thead>
          <tbody>
            {
              [...events].sort((a, b) => b.date.localeCompare(a.date)).map((e) => (
                <tr>
                  <td class="num">{formatDate(e.date, true)}</td>
                  <td>{laneLabel[e.lane as keyof typeof laneLabel]}: {e.title}</td>
                  <td>{e.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </ChartFigure>

    <ChartFigure title="Days between seizure episodes" subtitle="Lengthening until the October cluster." chart="intervals" points={gaps}>
      <div class="table-wrap">
        <table>
          <thead><tr><th>From</th><th>To</th><th class="num">Days</th></tr></thead>
          <tbody>
            {
              gaps.map((g) => (
                <tr>
                  <td>{formatDate(g.from)}</td>
                  <td>{formatDate(g.to)}</td>
                  <td class="num">{g.days}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </ChartFigure>
  </div>

  <h2>All seizures</h2>
  <div class="table-wrap">
    <table class="stack">
      <thead>
        <tr><th class="num">#</th><th>Date</th><th>Time</th><th>Duration</th><th>Warning signs</th><th>Afterwards</th><th>Recovery</th></tr>
      </thead>
      <tbody>
        {
          seizures.map((s) => (
            <tr>
              <td class="num hide-sm">{s.number}</td>
              <td class="num row-title">
                <a href={`#seizure-${s.number}`}>
                  <span class="show-sm">Seizure {s.number} · </span>
                  {formatDate(s.date, true)}
                </a>
                {s.cluster_with && <span class="badge badge-critical" style="margin-left:6px">Cluster</span>}
              </td>
              <td class="num" data-label="Time">{s.time ?? '—'}</td>
              <td class="num" data-label="Duration">{formatDuration(s.duration_seconds)}</td>
              <td class="hide-sm">{s.prodrome}</td>
              <td class="hide-sm">{s.post_ictal}</td>
              <td data-label="Recovery">{s.recovery}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="meta show-sm">Tap a seizure for the warning signs and what happened afterwards.</p>

  <h2>Warning signs log</h2>
  <p class="meta">Every episode of warning signs, whether or not a seizure followed. Northwest use this to judge whether starting levetiracetam early is working.</p>
  <div class="table-wrap">
    <table class="stack">
      <thead><tr><th>Date</th><th>Started</th><th>Signs</th><th>Levetiracetam started?</th><th>Seizure followed?</th><th>Notes</th></tr></thead>
      <tbody>
        {
          prodromes.map((p) => (
            <tr>
              <td class="num row-title">{formatDate(p.date, true)}</td>
              <td class="num" data-label="Started">{p.start ?? '—'}</td>
              <td data-label="Signs">{p.signs}</td>
              <td data-label="Levetiracetam">{p.levetiracetam}</td>
              <td data-label="Seizure followed">{p.seizure_followed ? <span class="badge badge-critical">Yes</span> : <span class="badge badge-good">No</span>}</td>
              <td data-label="Notes" class:list={{ 'hide-sm': !p.notes }}>{p.notes ?? '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Patterns</h2>
  <div class="card prose">
    <Patterns />
  </div>

  <h2>Seizure details</h2>
  <div class="grid">
    {
      seizures.map((s) => (
        <article class="card" id={`seizure-${s.number}`}>
          <p class="meta">
            Seizure {s.number} · {formatDuration(s.duration_seconds)} · {s.type}
            {s.cluster_with && <span class="badge badge-critical" style="margin-left:6px">Cluster with seizure {s.cluster_with}</span>}
          </p>
          <h3 style="margin-top:2px">
            {formatDate(s.date)}
            {s.time && ` · ${s.time}`}
          </h3>
          <dl class="detail">
            {s.prodrome && (<><dt>Warning signs</dt><dd>{s.prodrome}</dd></>)}
            {s.description && (<><dt>What happened</dt><dd>{s.description}</dd></>)}
            {s.post_ictal && (<><dt>Afterwards</dt><dd>{s.post_ictal}</dd></>)}
            {s.recovery && (<><dt>Recovery</dt><dd>{s.recovery}</dd></>)}
            {s.triggers && (<><dt>Possible triggers</dt><dd>{s.triggers}</dd></>)}
            {s.medications && (<><dt>Medication</dt><dd>{s.medications}</dd></>)}
            {s.context && (<><dt>Context</dt><dd>{s.context}</dd></>)}
          </dl>
          {s.video && (
            <details class="seizure-video">
              <summary>
                <span class="sv-title">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 6 6 6-6 6" />
                  </svg>
                  Show the video
                </span>
                <span class="sv-note">Footage of the seizure — it can be upsetting to watch</span>
              </summary>
              {youtubeId(s.video) ? (
                <>
                  <div class="video-frame" data-youtube={youtubeId(s.video)} data-title={`Video of seizure ${s.number}, ${formatDate(s.date)}`} />
                  <p class="meta video-link">
                    Not playing? <a href={s.video} target="_blank" rel="noopener">Open it on YouTube</a>
                  </p>
                </>
              ) : (
                <video controls preload="none" playsinline src={url(`/videos/${s.video}`)}>
                  <a href={url(`/videos/${s.video}`)}>Download the video</a>
                </video>
              )}
            </details>
          )}
        </article>
      ))
    }
  </div>

</Base>

<script>
  // Nothing loads until a panel is opened; closing it stops the footage rather than leaving it playing out of sight.
  document.querySelectorAll<HTMLDetailsElement>('.seizure-video').forEach((panel) => {
    const frame = panel.querySelector<HTMLElement>('.video-frame');
    panel.addEventListener('toggle', () => {
      if (frame) {
        if (panel.open && !frame.querySelector('iframe')) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.youtube}?rel=0&playsinline=1`;
          iframe.title = frame.dataset.title ?? 'Seizure video';
          iframe.allow = 'accelerometer; encrypted-media; fullscreen; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          frame.prepend(iframe);
        } else if (!panel.open) {
          frame.querySelector('iframe')?.remove();
        }
      } else if (!panel.open) {
        panel.querySelector('video')?.pause();
      }
    });
  });
</script>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 9rem) 1fr;
    gap: 6px 16px;
    margin: 10px 0 0;
  }

  .detail dt {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .detail dd {
    margin: 0;
  }

  .seizure-video {
    margin-top: 14px;
    border-top: 1px solid var(--grid);
    padding-top: 12px;
  }

  .seizure-video summary {
    display: flex;
    flex-direction: column;
    gap: 2px;
    cursor: pointer;
    list-style: none;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .seizure-video summary::-webkit-details-marker {
    display: none;
  }

  .seizure-video summary:hover {
    background: color-mix(in srgb, var(--surface-2) 70%, var(--axis));
  }

  .sv-title {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 650;
    color: var(--accent);
  }

  .sv-title svg {
    width: 16px;
    height: 16px;
    flex: none;
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .seizure-video[open] .sv-title svg {
    transform: rotate(90deg);
  }

  .seizure-video[open] .sv-title::after {
    content: '— tap to hide';
    font-weight: 400;
    color: var(--muted);
  }

  .sv-note {
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .seizure-video video {
    display: block;
    width: 100%;
    max-height: 70vh;
    margin-top: 12px;
    border-radius: var(--radius-sm);
    background: #000;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-top: 12px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #000;
  }

  .video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-link {
    margin: 8px 0 0;
  }

  @media (max-width: 520px) {
    .detail {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .detail dd {
      margin-bottom: 8px;
    }
  }
</style>
